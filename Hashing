#include <iostream>
using namespace std;

#define SIZE 10

class Hash {
    int a[SIZE];

public:
    Hash() {
        for(int i=0;i<SIZE;i++)
            a[i] = -1;
    }

    int hash(int key) {
        return (key % SIZE + SIZE) % SIZE;
    }

    void insert(int key) {
        int i = hash(key);

        while(a[i] != -1)
            i = (i + 1) % SIZE;

        a[i] = key;
    }

    void search(int key) {
        int i = hash(key), start = i;

        while(a[i] != -1) {
            if(a[i] == key) {
                cout << "Key found";
                return;
            }
            i = (i + 1) % SIZE;
            if(i == start) break;
        }

        cout << "Key not found";
    }

    void display() {
        for(int i=0;i<SIZE;i++)
            cout << i << " -> " << a[i] << endl;
    }
};

int main() {
    Hash h;

    h.insert(25);
    h.insert(35);
    h.insert(15);
    h.insert(42);
    h.insert(22);

    h.display();

    int key;
    cout << "Enter key: ";
    cin >> key;
    h.search(key);

    return 0;
}
